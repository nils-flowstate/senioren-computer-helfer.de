# Vorlage für die Produktionsvariablen (GEO-LLM.txt §12).
#
# Kopieren mit:  cp .env.example .env
# In .env stehen danach die echten Werte. Die Datei gehört NICHT nach Git und
# wird nicht ins Image kopiert. Keine dieser Variablen beginnt mit PUBLIC_ —
# damit erreicht kein Geheimnis jemals den Browser.

# --- Betrieb -----------------------------------------------------------------
# Innerhalb des Containers wird auf 0.0.0.0:3005 gelauscht. Nach außen gibt
# compose.yaml den Port ausschließlich an 127.0.0.1 frei.
HOST=0.0.0.0
PORT=3005
SITE_URL=https://senioren-computer-helfer.de

# Signiert das Sitzungs-Cookie. Ohne diesen Wert startet die Anwendung in der
# Produktion nicht — und das ist Absicht: Am Cookie hängt die Freigabe der
# Telefonnummer nach §16. Mindestens 32 Zeichen.
# Erzeugen mit:  openssl rand -hex 32
SESSION_SECRET=

# --- KI-Anbieter -------------------------------------------------------------
# Welcher Dienst den Chat beantwortet: "openai" oder "anthropic".
KI_ANBIETER=openai

# Nur nötig, wenn KI_ANBIETER=openai oder SPRACHE_ANBIETER=openai.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-transcribe
OPENAI_TTS_MODEL=gpt-4o-mini-tts

# Nur nötig, wenn KI_ANBIETER=anthropic.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
# Wie gründlich das Modell nachdenkt: low, medium, high, xhigh oder max.
# "medium" hält die Antworten kurz und die Wartezeit gering.
ANTHROPIC_AUFWAND=medium

# --- Sprachfunktionen --------------------------------------------------------
# "browser" nutzt Spracheingabe und Vorlesen des Geräts. Das ist die
# datensparsamste Einstellung: Es verlässt dabei nichts das Gerät.
# "openai" schickt Aufnahmen an eine serverseitige Route (§9).
SPRACHE_ANBIETER=browser

# --- Ablauf der Hilfe --------------------------------------------------------
# Nach so vielen erfolglosen Lösungsversuchen beginnt die Eskalation (§6, §16).
MAX_FAILED_ATTEMPTS=3

# Obergrenze für ein hochgeladenes Foto. Fotos aus modernen Handys sind groß;
# der Server verkleinert sie, muss sie aber erst annehmen können.
MAX_UPLOAD_MB=10

# --- Kontakt und Vor-Ort-Hilfe (§16) -----------------------------------------
# Die E-Mail-Adresse ist der Weg, der immer angeboten wird.
SUPPORT_EMAIL=

# Vor-Ort-Hilfe erscheint ausschließlich als Eskalation nach drei erfolglosen
# Versuchen — nie auf der Startseite und nie in den allgemeinen FAQ.
LOCAL_SERVICE_ENABLED=true
LOCAL_SERVICE_CITY=Koeln
LOCAL_SERVICE_COUNTRY=DE

# Telefon und WhatsApp bleiben abgeschaltet, solange der Ablauf nicht
# vollständig erprobt ist. Bei "false" steht die Nummer nirgends im
# ausgelieferten HTML — die Freigabe erfolgt serverseitig nach dem Ablauf aus
# §16 und erst nach zweimaligem ausdrücklichem "Ja".
ENABLE_PHONE_SUPPORT=false
SUPPORT_PHONE=

ENABLE_WHATSAPP_SUPPORT=false
SUPPORT_WHATSAPP=
WHATSAPP_AUTOMATION_URL=

# --- Schutz vor Überlastung und Kosten ---------------------------------------
RATE_LIMIT_PRO_MINUTE=12
MAX_NACHRICHTEN_PRO_SITZUNG=60
TAGESBUDGET_ANFRAGEN=2000
