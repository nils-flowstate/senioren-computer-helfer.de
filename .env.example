# Vorlage für .env (cp .env.example .env). Die echte .env gehört nicht nach Git
# und wird nicht ins Image kopiert.
#
# Die Domain steht nicht hier: TLS und Domain verwaltet der zentrale Caddy
# (/home/nils/caddy/Caddyfile), dieser Container lauscht nur auf Port 3005.

# SHA-256 (hex) des Lockscreen-Passworts. Neu: printf %s 'NEUES_PASSWORT' | sha256sum
GATE_PASSWORD_SHA256=BITTE_ERSETZEN_64_hex_zeichen
# Zufälliger Schlüssel für Signaturen, mindestens 32 Zeichen. Erzeugen: openssl rand -hex 32
GATE_SECRET=BITTE_ERSETZEN_openssl_rand_hex_32
