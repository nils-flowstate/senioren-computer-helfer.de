{
	admin off
	# TLS terminiert der zentrale Caddy (/home/nils/caddy). Dieser Container
	# spricht nur unverschlüsseltes HTTP im Docker-Netz "proxy".
	auto_https off
	persist_config off

	servers {
		# Nur Container im Netz "proxy" (also der zentrale Caddy) dürfen
		# X-Forwarded-For und X-Forwarded-Proto mitgeben. Ohne diese Zeile
		# hielte Caddy den zentralen Caddy selbst für den Besucher.
		trusted_proxies static 172.18.0.0/16
		client_ip_headers X-Forwarded-For
	}
}

# Adressbereiche von Cloudflare (https://www.cloudflare.com/ips-v4 und -v6,
# Stand Oktober 2026). Der zentrale Caddy vertraut Cloudflare nicht und setzt
# deshalb die Cloudflare-Adresse als Besucher ein. Die echte Adresse steht nur
# in CF-Connecting-IP — und diesem Kopf darf nur geglaubt werden, wenn die
# Anfrage wirklich von Cloudflare kam. Sonst könnte jemand am Cloudflare-Schutz
# vorbei direkt den Server ansprechen und sich bei jedem Versuch eine neue
# Adresse ausdenken, um der Sperre nach fünf Fehlversuchen zu entgehen.
(cloudflare) {
	client_ip 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
}

:3005 {
	root * /srv
	encode zstd gzip

	# Bewusst kein Zugriffsprotokoll: Es stünde die Adresse jedes Besuchers im
	# Klartext darin (AGENTS.md, Regel 4). Für die Sperre nach Fehlversuchen
	# merkt sich das Gate die Adresse selbst, zweckgebunden und befristet.

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Strict-Transport-Security "max-age=31536000"
		X-Frame-Options DENY
		# X-Robots-Tag (noindex) setzt der zentrale Caddy für diese Domain;
		# hier doppelt gesetzt, stünde der Kopf zweimal in der Antwort.
		-Server
	}

	@ueber_cloudflare {
		import cloudflare
	}
	@direkt {
		not {
			import cloudflare
		}
	}
	vars @ueber_cloudflare besucher_ip {header.CF-Connecting-IP}
	vars @direkt besucher_ip {client_ip}

	# Außer dem Lockscreen das Einzige, was Bots ohne Passwort zu sehen bekommen.
	handle /robots.txt {
		header Content-Type "text/plain; charset=utf-8"
		respond <<TEXT
			User-agent: *
			Disallow: /
			TEXT 200
	}

	# Für den Healthcheck des Containers, ohne Gate.
	handle /health {
		respond "ok" 200
	}

	# Gate-API (Rechenaufgabe, Login). /gate/check nur intern.
	handle /gate/* {
		@gatecheck path /gate/check
		respond @gatecheck 404
		reverse_proxy gate:3000 {
			header_up X-Forwarded-For {vars.besucher_ip}
		}
	}

	# Nils schaut sich Fotos und Dokumente an. Nur mit Anmeldung: Ohne gültige
	# Sitzung gibt das Gate 401 zurück, und das geht so an den Browser.
	handle /api/ki/* {
		forward_auth gate:3000 {
			uri /gate/check
			header_up X-Forwarded-For {vars.besucher_ip}
		}
		# Fotos verkleinert der Browser; PDF-Dokumente bis 10 MB wachsen als Base64 um ein Drittel.
		request_body {
			max_size 30MB
		}
		header Cache-Control "no-store"
		reverse_proxy ki:3000 {
			header_up X-Forwarded-For {vars.besucher_ip}
			transport http {
				response_header_timeout 120s
			}
		}
	}

	# Ohne Anmeldung erreichbar: nur was der Lockscreen braucht
	@public path /lock.html /support.js /nils.webp /fonts/* /vendor/*
	handle @public {
		file_server
	}

	# Alles andere: Gate fragen. 401 → Lockscreen unter derselben URL.
	handle {
		header Cache-Control "no-store"
		forward_auth gate:3000 {
			uri /gate/check
			header_up X-Forwarded-For {vars.besucher_ip}
			@denied status 401
			handle_response @denied {
				rewrite * /lock.html
				file_server
			}
		}
		try_files {path} {path}.html {path}/index.html
		file_server
	}

	handle_errors {
		respond "Seite nicht gefunden" 404
	}
}
