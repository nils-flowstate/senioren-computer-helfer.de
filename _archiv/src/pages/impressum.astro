---
import Layout from '../komponenten/Layout.astro'
---

<Layout
    titel="Impressum · Senioren-Computer-Helfer"
    beschreibung="Anbieterkennzeichnung nach § 5 Digitale-Dienste-Gesetz für senioren-computer-helfer.de."
    pfad="/impressum"
>
    <h1 class="mb-4">Impressum</h1>

    <div class="lesebreite rounded-xl bg-warnung-flaeche p-4 text-warnung-text">
        <p class="font-bold">Diese Seite ist noch nicht ausgefüllt.</p>
        <p class="mt-2">
            Vor der Veröffentlichung müssen hier Name, Anschrift, E-Mail-Adresse
            und — falls vorhanden — Umsatzsteuer-Identifikationsnummer stehen.
            § 5 Digitale-Dienste-Gesetz verlangt diese Angaben für geschäftsmäßige
            Websites.
        </p>
    </div>

    <p class="mt-8"><a href="/">Zurück zum Hilfe-Chat</a></p>
</Layout>
