---
import type { FaqEintrag } from '../inhalte/faq'

interface Props {
    ueberschrift: string
    eintraege: FaqEintrag[]
}

const { ueberschrift, eintraege } = Astro.props
---

<!--
    In der Startansicht stehen die Fragen offen unter dem Chat (§8). Im
    laufenden Gespräch treten sie hinter eine Zeile zurück, bleiben aber mit
    einem Tipp erreichbar — der sichtbare Text und das FAQPage-Markup bleiben
    damit dieselbe Quelle.
-->
<section aria-label={ueberschrift} class="mt-12">
    <h2 class="nur-startansicht mb-6">{ueberschrift}</h2>

    <button
        type="button"
        id="faq-oeffner"
        aria-expanded="false"
        aria-controls="faq-liste"
        class="faq-oeffner tippziel w-full rounded-xl border-2 border-linie bg-flaeche px-4 font-bold text-primaer-aktiv"
    >
        Häufige Fragen anzeigen
    </button>

    <div id="faq-liste" class="faq-liste flex flex-col gap-3">
        {
            eintraege.map((eintrag) => (
                <details class="rounded-xl border-2 border-linie bg-flaeche">
                    <summary class="tippziel flex flex-col justify-center gap-1 px-4 py-3">
                        <span class="font-bold">{eintrag.frage}</span>
                        <span class="klapp-hinweis" aria-hidden="true">
                            Hier klicken für die Antwort
                        </span>
                    </summary>
                    <div class="border-t-2 border-linie px-4 py-4">
                        <p class="lesebreite">{eintrag.antwort}</p>
                        {eintrag.weiterlesen && (
                            <p class="mt-3">
                                <a href={eintrag.weiterlesen.ziel}>{eintrag.weiterlesen.text}</a>
                            </p>
                        )}
                    </div>
                </details>
            ))
        }
    </div>
</section>
