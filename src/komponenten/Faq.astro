---
/*
 * Fragen und Antworten als Aufklapper unter dem Eingabefeld.
 *
 * Warum dort und nicht als Liste unter dem Chat: Auf dem Handy schob die
 * offene Liste alles Weitere aus dem Bild, und im laufenden Gespräch stand sie
 * quer. Als Zeile am Eingabefeld ist sie in jedem Zustand mit einem Tipp
 * erreichbar und kostet geschlossen 56 Pixel.
 *
 * Warum ohne JavaScript: Die Sicherheitsrichtlinie erlaubt weder eingebettete
 * Skripte noch eingebettete Stile (src/middleware.ts). <details> kann das
 * Auf- und Zuklappen selbst — mit Tastatur, mit Vorlesegerät und auch dann,
 * wenn der Chat mangels JavaScript stumm bleibt. Der sichtbare Text bleibt
 * dabei deckungsgleich mit dem FAQPage-Markup, weil beide aus derselben Liste
 * kommen.
 */
import type { FaqEintrag } from '../inhalte/faq'

interface Props {
    ueberschrift: string
    eintraege: FaqEintrag[]
}

const { ueberschrift, eintraege } = Astro.props
---

<details class="fragen">
    <!--
        Die Beschriftung wechselt beim Öffnen. Ein Pfeil allein sagt einem
        ungeübten Auge nicht, was ein Tipp bewirkt.
    -->
    <summary class="fragen-zeile">
        <span>
            <span class="fragen-auf">{ueberschrift}</span>
            <span class="fragen-zu">{ueberschrift} schließen</span>
        </span>
        <span class="pfeil" aria-hidden="true">▾</span>
    </summary>

    <!--
        Legt sich über den Chat, statt ihn zu verschieben: Die Zeile bleibt
        dort stehen, wo der Finger war, und das Eingabefeld springt nicht weg.
        Die Höhe ist gedeckelt, siehe basis.css.
    -->
    <div class="fragen-liste">
        <!-- Für die Gliederung und für Vorlesegeräte. Sichtbar stünde hier
             dasselbe Wort wie auf der Zeile darunter. -->
        <h2 class="nur-vorlesen">{ueberschrift}</h2>

        {
            eintraege.map((eintrag) => (
                <details>
                    <summary>
                        <span>{eintrag.frage}</span>
                        <span class="pfeil" aria-hidden="true">▾</span>
                    </summary>
                    <div class="antwort">
                        <p>{eintrag.antwort}</p>
                        {eintrag.weiterlesen && (
                            <p class="mt-3">
                                <a href={eintrag.weiterlesen.ziel}>{eintrag.weiterlesen.text}</a>
                            </p>
                        )}
                    </div>
                </details>
            ))
        }
    </div>
</details>
